{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "2.0.0"
    },
    "conversation_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "checklist_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "checklist_version": {
      "type": "integer",
      "minimum": 1
    },
    "answers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/criterion_answer"
      }
    },
    "diagnostics": {
      "$ref": "#/$defs/diagnostics"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    }
  },
  "required": [
    "contract_version",
    "request_id",
    "conversation_id",
    "checklist_key",
    "checklist_version",
    "answers",
    "diagnostics"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "message_id": {
          "type": "string",
          "pattern": "^m[0-9]{4,}$"
        },
        "quote": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "message_id",
        "quote"
      ]
    },
    "criterion_answer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "criterion_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "answer": {
          "enum": [
            "yes",
            "no",
            "na",
            "scale"
          ]
        },
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "explanation": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      },
      "required": [
        "criterion_id",
        "answer",
        "value",
        "explanation",
        "evidence"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "answer": {
                "const": "scale"
              }
            },
            "required": [
              "answer"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": "number",
                "minimum": 0
              }
            }
          },
          "else": {
            "properties": {
              "value": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "prompt_version": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "attempt_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "estimated_cost_usd": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "latency_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "warnings": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "DOMAIN_FACT_UNVERIFIED",
              "TRANSCRIPTION_AMBIGUOUS",
              "AUDIO_NOT_ASSESSED",
              "MODEL_UNCERTAINTY"
            ]
          }
        }
      },
      "required": [
        "provider",
        "model",
        "prompt_version",
        "attempt_count",
        "input_tokens",
        "output_tokens",
        "estimated_cost_usd",
        "latency_ms",
        "warnings"
      ]
    }
  }
}
