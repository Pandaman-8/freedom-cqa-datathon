# Keep .env private. Groq account must actually be on Free Plan (not Developer).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Set true only after checking the organization plan in the Groq console.
# This is an operator assertion, NOT an API-enforced spending cap.
GROQ_FREE_PLAN_CONFIRMED=false
# Only bundled own-synthetic conversation fingerprints are accepted.
ML_DATA_POLICY=synthetic_only
